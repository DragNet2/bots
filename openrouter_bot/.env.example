# Telegram-бот (токен от @BotFather)
BOT_TOKEN=

# Обычный API-ключ OpenRouter (https://openrouter.ai/keys) — баланс
OPENROUTER_API_KEY=

# Management-ключ OpenRouter (требуется для /models — история расхода).
# Если не задать, будет использован OPENROUTER_API_KEY, но тогда /models
# вернёт ошибку 403 (activity доступен только management-ключу).
OPENROUTER_MGMT_KEY=

# ID чатов, которым разрешено общаться с ботом (через запятую)
ALLOWED_CHATS=233590599

# Интервал фоновой проверки баланса для алертов, минуты
CHECK_INTERVAL_MIN=30
